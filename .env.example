# Copy this file to `.env` and fill in the key for your chosen provider.
# The .env file is git-ignored and never committed.
# Deterministic tests do NOT need any key.

# Which model vendor to use: "anthropic" (default) or "openai".
DUNGEON_PROVIDER=anthropic

# --- Anthropic (Claude) — the default provider ---
# Get a key at https://console.anthropic.com/ -> Settings -> API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- OpenAI — only needed if DUNGEON_PROVIDER=openai ---
# OPENAI_API_KEY=sk-your-key-here

# Optional. Overrides the per-provider default model.
#   anthropic default: claude-haiku-4-5   (cheapest current Claude: $1/$5 per 1M tokens)
#   openai default:    gpt-4o-mini
# DUNGEON_MODEL=claude-haiku-4-5

# Optional. Start the game in debug mode (see tool/agent activity under the hood).
# Off by default; toggle at runtime with the in-game `debug` command.
# DUNGEON_DEBUG=1

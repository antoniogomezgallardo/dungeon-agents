# Copy this file to `.env` and fill in your key.
# The .env file is git-ignored and never committed.

# Required to run the game (Milestone 1 onward). Deterministic tests do NOT need it.
OPENAI_API_KEY=sk-your-key-here

# Optional. Defaults to a small, fast model if unset.
DUNGEON_MODEL=gpt-4o-mini
